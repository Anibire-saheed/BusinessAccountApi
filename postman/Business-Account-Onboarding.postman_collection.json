		{
			"name": "11. Upload Principal File - PASSPORT_PHOTO",
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/business-account/applications/{{applicationUUID}}/principals/{{principalId}}/files/PASSPORT_PHOTO",
					"host": ["{{baseUrl}}"],
					"path": ["business-account", "applications", "{{applicationUUID}}", "principals", "{{principalId}}", "files", "PASSPORT_PHOTO"]
